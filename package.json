{
  "name": "melimetrics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "build": "vite build",
    "verify:frontend": "npm run typecheck && npm run lint && npm run test && npm run build",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset",
    "supabase:verify": "node scripts/verify-supabase.mjs",
    "pipeline:sync": "uv --directory pipeline sync --frozen",
    "pipeline:lint": "uv --directory pipeline run ruff check .",
    "pipeline:typecheck": "uv --directory pipeline run mypy src tests",
    "pipeline:test": "uv --directory pipeline run pytest",
    "verify": "npm run verify:frontend && npm run test:e2e && npm run supabase:verify && npm run pipeline:sync && npm run pipeline:lint && npm run pipeline:typecheck && npm run pipeline:test"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^27.2.0",
    "playwright": "^1.64.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
